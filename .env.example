# ─── AGENTES (OLLAMA LOCAL, MESMO MODELO NOS 3 SISTEMAS) ─────────────────────
AGENT_MODEL=qwen3.5:2b
OLLAMA_URL=http://localhost:11434
AGENT_REASONING=false
AGENT_MAX_REVISOES=1
AGENT_MAX_CHAMADAS_AGENTE=8
AGENT_MAX_DELEGACOES=4

# ─── CONFIGURAÇÃO DO JUIZ FRONTIER (MCP READ-ONLY) ──────────────────────────
# Provedor padrão: "gemini" (free-tier friendly via Google AI Studio)
# Opções suportadas: "gemini" | "openai_compatible" | "ollama"
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
JUDGE_MIN_DELAY_SECONDS=4.0

# ─── FALLBACK 1: OPENAI-COMPATIBLE (Groq, OpenRouter, OpenAI) ───────────────
# Exemplo com Groq (Llama 3.3 70B — família diferente do Qwen):
# JUDGE_PROVIDER=openai_compatible
# JUDGE_MODEL=llama-3.3-70b-versatile
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=gsk_...
# JUDGE_MIN_DELAY_SECONDS=2.0

# ─── FALLBACK 2: OLLAMA LOCAL (Gemma 3 ou Llama 3.1 — NÃO usar Qwen) ────────
# JUDGE_PROVIDER=ollama
# JUDGE_MODEL=gemma3:12b
# OLLAMA_URL=http://localhost:11434
# JUDGE_MIN_DELAY_SECONDS=0.0
